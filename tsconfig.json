{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node", "vue", "pinia", "nuxt"],
    "paths": {
      "~/*": ["./app/*"],
      "@/*": ["./app/*"],
      "#imports": ["./.nuxt/imports.d.ts"]
    }
  },
  "include": ["app/**/*", "server/**/*", "types/**/*", "types.d.ts"]
}
